# Extra Helm parameters for the greeter Application, read by
# scripts/generate-argocd-apps.sh. One `helm --set`-style KEY=VALUE per
# line; KEY is the dotted Helm value path.
#
# image.repository/tag deliberately NOT set here: they live in
# values.yaml now (image.repository is fixed; image.tag is owned by Argo
# CD Image Updater, which writes straight into values.yaml — see
# charts/env/prod/central-services/argocd-image-updater/templates/imageupdater.yaml).
# A `parameters:` override here would take precedence over Image Updater's
# values.yaml write and silently pin the app to a stale tag forever.
env.HELLO_TAG=hivemind-prod
