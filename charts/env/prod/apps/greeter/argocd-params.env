# Extra Helm parameters for the greeter Application, read by
# scripts/generate-argocd-apps.sh. One `helm --set`-style KEY=VALUE per
# line; KEY is the dotted Helm value path.
#
# image.repository/tag have no default in values.yaml (required, see that
# chart's README) so they must come from somewhere — CI should overwrite
# image.tag here (or this whole file) after each build/push rather than
# editing charts/env/prod/argocd-apps.yaml by hand.
image.repository=324464328617.dkr.ecr.us-east-1.amazonaws.com/hivemind-greeter
image.tag=unset
env.HELLO_TAG=hivemind-prod
